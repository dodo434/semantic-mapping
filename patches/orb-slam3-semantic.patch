diff --git a/src/System.cc b/src/System.cc
index 60d9c51..b86421c 100644
--- a/src/System.cc
+++ b/src/System.cc
@@ -475,6 +475,43 @@ Sophus::SE3f System::TrackMonocular(const cv::Mat &im, const double &timestamp,
 
 
 
+void System::SetDynamicStereoMasks(const cv::Mat& left, const cv::Mat& right)
+{
+    cv::Mat preparedLeft = left, preparedRight = right;
+    if (settings_ && settings_->needToRectify() && !left.empty() && !right.empty()) {
+        preparedLeft.release();
+        preparedRight.release();
+        cv::remap(left, preparedLeft, settings_->M1l(), settings_->M2l(),
+                  cv::INTER_NEAREST, cv::BORDER_CONSTANT, cv::Scalar(255));
+        cv::remap(right, preparedRight, settings_->M1r(), settings_->M2r(),
+                  cv::INTER_NEAREST, cv::BORDER_CONSTANT, cv::Scalar(255));
+    } else if (settings_ && settings_->needToResize() && !left.empty() && !right.empty()) {
+        cv::resize(left, preparedLeft, settings_->newImSize(), 0, 0, cv::INTER_NEAREST);
+        cv::resize(right, preparedRight, settings_->newImSize(), 0, 0, cv::INTER_NEAREST);
+    }
+    mpTracker->SetDynamicStereoMasks(preparedLeft, preparedRight);
+}
+
+bool System::GetTrackedBodyPose(Sophus::SE3f& body_to_world, unsigned long& map_id)
+{
+    if (GetTrackingState() != Tracking::OK || !mpAtlas->isImuInitialized())
+        return false;
+    body_to_world = mpTracker->mCurrentFrame.GetImuPose();
+    map_id = mpAtlas->GetCurrentMap()->GetId();
+    return true;
+}
+
+bool System::GetLatestBodyKeyframe(Sophus::SE3f& body_to_world, unsigned long& id, double& stamp)
+{
+    auto* keyframe = mpTracker->GetLastKeyFrame();
+    if (!keyframe || keyframe->isBad())
+        return false;
+    body_to_world = keyframe->GetImuPose();
+    id = keyframe->mnId;
+    stamp = keyframe->mTimeStamp;
+    return true;
+}
