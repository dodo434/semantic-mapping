#!/usr/bin/env python3

import rclpy
from rclpy.executors import ExternalShutdownException

from semantic_mapping.fusion import Fusion


def main():
    rclpy.init()
    try:
        node = Fusion()
        try:
            rclpy.spin(node)
        finally:
            node.destroy_node()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
